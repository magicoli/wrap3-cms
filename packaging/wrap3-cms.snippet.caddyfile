# W.R.A.P. 3 CMS (wrap3-cms-caddy package): directives serving the CMS as
# Apache does, the CMS files at /wrap/ and wrap.php for the folders of the
# site without an index file. Imported by a site block with the site root as
# argument, see the default site, /etc/caddy/sites/wrap3-cms.caddyfile.
#
# The CMS reads the site folders from DOCUMENT_ROOT, and builds its URLs from
# SCRIPT_NAME (/wrap/wrap.php). PHP-FPM through the php-fpm.sock alternative.

# Folders are addressed with a trailing slash, as Apache redirects them
@wrap_folder_noslash {
	file {path}/
	not path */
}
redir @wrap_folder_noslash {path}/ 308

# Folders without an index file: wrap.php, keeping the requested URL
@wrap_folder {
	file {path}/
	not file {path}/index.html {path}/index.htm {path}/index.php
}
route @wrap_folder {
	reverse_proxy unix//run/php/php-fpm.sock {
		transport fastcgi {
			env SCRIPT_FILENAME /usr/share/wrap3-cms/wrap.php
			env SCRIPT_NAME /wrap/wrap.php
			env DOCUMENT_ROOT {args.0}
		}
	}
}

# The CMS files: PHP entry points (legacy/download.php...) and static assets
handle_path /wrap/* {
	root * /usr/share/wrap3-cms
	php_fastcgi unix//run/php/php-fpm.sock {
		env SCRIPT_NAME {http.request.orig_uri.path}
		env DOCUMENT_ROOT {args.0}
	}
	file_server
}
